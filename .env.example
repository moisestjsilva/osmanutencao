# =========================================================
# CONFIGURAÇÕES DA APLICAÇÃO NOVA OS
# =========================================================
PORT=3000
PUBLIC_URL=http://localhost:3000

# =========================================================
# INTEGRAÇÃO WHATSAPP (PADRÃO ADAPTER)
# =========================================================
# true = Ativa o envio automático ao abrir OS
# false = Desativa totalmente qualquer chamada de WhatsApp
WHATSAPP_ENABLED=false

# Provedor ativo: 'wapi' (atual) ou 'evolution' (futuro)
WHATSAPP_PROVIDER=wapi

# ID do Grupo de Manutenção no WhatsApp (ex: 120363000000000000@g.us)
WHATSAPP_GROUP_ID=

# ---------------------------------------------------------
# 1. Configurações da W-API (https://docs.w-api.app/)
# ---------------------------------------------------------
WAPI_BASE_URL=https://api.w-api.app/v1
WAPI_INSTANCE_ID=
WAPI_API_KEY=

# ---------------------------------------------------------
# 2. Configurações da Evolution API (v2) - Uso Futuro
# ---------------------------------------------------------
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE_NAME=manutencao
EVOLUTION_API_KEY=
